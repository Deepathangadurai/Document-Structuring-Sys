# Application Settings
STORAGE_PATH=/storage
TEMPLATE_PATH=/templates
MAX_UPLOAD_SIZE=524288000
JWT_SECRET=change-me

# Model & Embeddings Configuration
MODEL_PROVIDER=qwen2.5-vl
MODEL_URL=http://localhost:11434
MODEL_NAME=qwen2.5vl:7b

# Database - SQLite for now (file lives under storage/app.db, zero setup).
# Swapping to Postgres later only requires changing this URL and installing
# psycopg2-binary; nothing else in the app is SQLite-specific.
DATABASE_URL=sqlite:///./storage/app.db
# --- OR, when you're ready to migrate: ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=documentdb
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/documentdb

# Qdrant Vector Search (run locally: `qdrant` binary or `pip install qdrant-client` + local server)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_PORT=6333

# Server & Network Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Vite / HMR Configuration
VITE_HMR_HOST=http://localhost
VITE_HMR_CLIENT_PORT=5173

# LibreOffice (used for docx page preview rendering) — point at your local install
LIBREOFFICE_PATH=/usr/bin/soffice

# Gotenberg (optional local document-conversion service, no Docker needed —
# run the gotenberg binary directly, or leave unset to use soffice only)
GOTENBERG_URL=http://localhost:3000