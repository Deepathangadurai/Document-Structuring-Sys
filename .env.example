# Application Settings
STORAGE_PATH=../storage
TEMPLATE_PATH=../templates
MAX_UPLOAD_SIZE=524288000
JWT_SECRET=change-me

# Model & Embeddings Configuration
# NOTE: MODEL_URL=http://localhost:8000 would point the model client at
# your own backend (port 8000), not Ollama. If you're not exercising the
# extraction/model features while debugging the template preview, this is
# harmless - but if you do run Ollama locally, point this at its real
# port instead (default 11434):
#   MODEL_URL=http://localhost:11434
MODEL_PROVIDER=qwen2.5-vl
MODEL_URL=http://ollama:11434
MODEL_NAME=qwen2.5vl:7b

# Database (PostgreSQL) - only used if you're running a real local Postgres.
# If you'd rather skip installing Postgres entirely, comment this out and
# use the SQLite line below instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documentdb
OSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/documentdb

# --- OR: skip Postgres entirely for local debugging ---
#DATABASE_URL=sqlite:///./sql_app.db

# Qdrant Vector Search (not needed for the template upload/preview flow -
# only touched by embedding/extraction features)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_PORT=6333

# Server & Network Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Vite / HMR Configuration
VITE_HMR_HOST=5173-01m0axhvws1j9m1qmp1r1wveab.cloudspaces.litng.ai
VITE_HMR_CLIENT_PORT=443

LIBREOFFICE_PATH=/usr/bin/libreoffice
GOTENBERG_URL=http://localhost:3000

