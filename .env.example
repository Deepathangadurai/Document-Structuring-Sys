# Application Settings
STORAGE_PATH=/storage
TEMPLATE_PATH=/templates
MAX_UPLOAD_SIZE=524288000
JWT_SECRET=change-me

# Model & Embeddings Configuration
MODEL_PROVIDER=qwen2.5
MODEL_URL=http://localhost:11434
MODEL_NAME=qwen2.5:1.5b-instruct
MODEL_TIMEOUT_SECONDS=600

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documentdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/documentdb

# Qdrant Vector Search
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_PORT=6333

# Server & Network Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Vite / HMR Configuration
VITE_HMR_HOST=http://localhost
VITE_HMR_CLIENT_PORT=5173

# LibreOffice
LIBREOFFICE_PATH=/usr/bin/soffice

# Gotenberg
GOTENBERG_URL=http://localhost:3000
